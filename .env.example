# Copia este archivo a .env y completa solo lo que uses.
# El proxy (vite-ai-proxy.ts) lee estas variables con defaults seguros.

# FreeLLMAPI local: la base del gateway y su key (la del panel de FreeLLMAPI)
FREELLM_BASE_URL=http://localhost:3001/v1
FREELLM_API_KEY=

# OpenRouter (opcional, para modelos de chat/imágenes por nombre)
OPENROUTER_API_KEY=

# Modelos: "auto" deja que FreeLLMAPI elija con la cuota disponible
FREELLM_MODEL=auto
OR_CHAT_MODEL=deepseek/deepseek-chat
OR_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
